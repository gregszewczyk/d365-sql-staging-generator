<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>D365EarlyBoundGenerator</RootNamespace>
    <AssemblyName>D365EarlyBoundGenerator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D365SqlStagingGenerator.Shared\D365SqlStagingGenerator.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <!-- CrmSvcUtil.exe is shipped inside this package.
         ExcludeAssets=all prevents it from being referenced for compile;
         GeneratePathProperty exposes PkgMicrosoft_CrmSdk_CoreTools for our Target below. -->
    <PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.1.0.164" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyCrmSvcUtil" AfterTargets="Build">
    <ItemGroup>
      <CrmSvcUtilFiles Include="$(PkgMicrosoft_CrmSdk_CoreTools)\content\bin\coretools\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CrmSvcUtilFiles)"
          DestinationFiles="@(CrmSvcUtilFiles->'$(OutputPath)crmsvcutil\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
